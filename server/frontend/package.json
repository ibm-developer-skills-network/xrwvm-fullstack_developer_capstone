    "react-router-dom": "^6.19.0",
    "react-scripts": "5.0.1",
    "tailwind-variants": "^3.3.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/styles/tailwind.css -o src/styles/home.generated.css --minify",
